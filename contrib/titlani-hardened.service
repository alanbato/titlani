# Titlani Misfin Mail Server — hardened systemd service
#
# Multi-user / production deployment. Same prerequisites as titlani.service,
# with additional kernel and filesystem hardening.

[Unit]
Description=Titlani Misfin Mail Server
Documentation=https://github.com/alanbato/titlani
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Update this path to match your installation (run: which titlani)
ExecStart=/usr/local/bin/titlani serve --config /etc/titlani/server.toml

# Run as a dedicated system user (create with useradd --system titlani)
# We use a real user instead of DynamicUser so that certificate files
# persist across restarts with stable ownership.
User=titlani
Group=titlani

# State and configuration directories
StateDirectory=titlani
ConfigurationDirectory=titlani

# --- Security hardening ---

# Prevent privilege escalation
NoNewPrivileges=yes

# Mount the root filesystem read-only (StateDirectory/ConfigurationDirectory still writable)
ProtectSystem=strict

# Prevent access to /home, /root, and /run/user
ProtectHome=yes

# Use a private /tmp
PrivateTmp=yes

# Prevent modification of kernel tunables (/proc/sys, /sys)
ProtectKernelTunables=yes

# Prevent loading kernel modules
ProtectKernelModules=yes

# Prevent access to control groups (/sys/fs/cgroup)
ProtectControlGroups=yes

# Only allow IPv4 and IPv6 sockets
RestrictAddressFamilies=AF_INET AF_INET6

# Restrict syscalls to those needed by a network service
SystemCallFilter=@system-service

# Only allow binding to privileged ports (if needed)
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Note: MemoryDenyWriteExecute is intentionally omitted — it blocks
# Python threading/ctypes which titlani uses for async I/O.

# Allow writing to /var/lib/titlani (StateDirectory) and /etc/titlani (ConfigurationDirectory)
ReadWritePaths=/var/lib/titlani /etc/titlani

# Restart policy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
